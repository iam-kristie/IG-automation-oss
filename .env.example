# Instagram API credentials
IG_APP_ID=your_app_id
IG_APP_SECRET=your_app_secret
IG_ACCESS_TOKEN=your_long_lived_token

# Webhook verification token (you choose this — must match Meta dashboard)
WEBHOOK_VERIFY_TOKEN=your_random_string_here

# Admin dashboard password (leave empty for no auth in local dev)
ADMIN_PASSWORD=your_password_here

# Persistent data directory (set to your volume mount path in production)
# DATA_DIR=/data

# Port for webhook server
PORT=3100

# Only needed by the cron service (Dockerfile.cron), not the server:
# WEBHOOK_URL=https://your-deployed-server.example.com
