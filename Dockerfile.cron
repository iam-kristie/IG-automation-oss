FROM curlimages/curl:8.23.0
USER root
RUN apk add --no-cache --upgrade ca-certificates \
    && update-ca-certificates
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
USER curl_user
# Railway cron service: triggers the snapshot endpoint on the webhook server.
# Requires WEBHOOK_URL and ADMIN_PASSWORD environment variables.
# Example schedule: 0 1 * * * (daily at 01:00 UTC = 09:00 HKT)
CMD curl -sf --connect-timeout 10 --max-time 300 -X POST \
  -u "admin:${ADMIN_PASSWORD}" \
  "${WEBHOOK_URL}/api/snapshots/run" \
  && echo "Snapshot triggered successfully" \
  || echo "Snapshot trigger failed"
